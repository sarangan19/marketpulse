{
  "info": {
    "name": "MarketPulse",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "frontendUrl",
      "value": ""
    },
    {
      "key": "idToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "smoke",
      "item": [
        {
          "name": "health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "watchlist requires auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/watchlist",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "frontend serves index",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{frontendUrl}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "api",
      "item": [
        {
          "name": "get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "update me",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"digestOptIn\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "add AAPL",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/watchlist/AAPL",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upper\": 300,\n  \"lower\": 150\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "bad thresholds",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/watchlist/AAPL",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upper\": 100,\n  \"lower\": 200\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "unknown symbol",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/watchlist/ZZZZZ",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upper\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "get watchlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/watchlist",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/symbols/search?q=apple",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/symbols/AAPL/history?days=7",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "trigger digest",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/digest/trigger",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "remove AAPL",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/watchlist/AAPL",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{idToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
